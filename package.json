{
  "name": "@nn12138/dsh-voice",
  "version": "0.2.5",
  "description": "Voice input plugin for DeepSeek Harness: microphone → local/browser speech recognition → text submitted as a normal chat message (input-only, preset-agnostic)",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "sherpa-onnx-node": "^1.13.5",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsdown --config tsdown.config.ts",
    "prepare": "npm run build"
  },
  "allowScripts": {
    "esbuild": true
  },
  "files": [
    "lib/**/*",
    "cordis.patch.yml",
    "CONTEXT.md",
    "README.zh.md",
    "USAGE.md",
    "INSTALL.md",
    "tools/"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "voice",
    "speech",
    "asr",
    "mic"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "bin": {
    "dsh-voice-models": "tools/download-models.cjs"
  }
}
